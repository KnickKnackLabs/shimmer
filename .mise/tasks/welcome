#!/usr/bin/env bash
#MISE description="Welcome message and status check for agents"

set -e

# Load shared check functions
source "$MISE_CONFIG_ROOT/lib/checks.sh"
source "$MISE_CONFIG_ROOT/lib/gpg.sh"

# Determine current agent from environment or git config
if [ -n "$GIT_AUTHOR_EMAIL" ]; then
  AGENT="${GIT_AUTHOR_EMAIL%@ricon.family}"
elif git config user.email 2>/dev/null | grep -q '@ricon.family'; then
  AGENT=$(git config user.email)
  AGENT="${AGENT%@ricon.family}"
else
  AGENT=""
fi

# Task sibling directory (for helpers like _days-until)
TASK_DIR="$MISE_CONFIG_ROOT/.mise/tasks"

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ -n "$AGENT" ]; then
  echo "  Welcome home, $AGENT."
else
  echo "  Welcome."
  echo ""
  echo "  No agent identity detected."
  echo "  Run: eval \$(shimmer as <agent>)"
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Identity check (env var or git config)
if [ -n "$GIT_AUTHOR_EMAIL" ] && echo "$GIT_AUTHOR_EMAIL" | grep -q '@ricon.family'; then
  print_status "Identity" "✓" "$GIT_AUTHOR_EMAIL"
elif git config user.email 2>/dev/null | grep -q '@ricon.family'; then
  print_status "Identity" "✓" "$(git config user.email)"
else
  print_status "Identity" "✗" "not set" "eval \$(shimmer as <agent>)"
fi

# GPG uses the same effective process configuration as gpg:status.
if SIGNING_STATUS=$(git_signing_status); then
  print_status "GPG" "✓" "$SIGNING_STATUS" "shimmer gpg:status"
else
  print_status "GPG" "✗" "$SIGNING_STATUS" "shimmer gpg:status"
fi

if [ -n "$AGENT" ]; then
  check_email

  # Matrix check
  MATRIX_CREDS="$HOME/.config/matrix-commander/$AGENT/credentials.json"
  if [ -f "$MATRIX_CREDS" ]; then
    print_status "Matrix" "✓" "logged in" "shimmer matrix:welcome"
  else
    print_status "Matrix" "✗" "not logged in" "shimmer matrix:login $AGENT"
  fi

  # GitHub check
  if [ -z "$GH_TOKEN" ]; then
    print_status "GitHub" "✗" "no token" "eval \$(shimmer as $AGENT)"
  elif ! GH_RESPONSE=$(gh api /user -i 2>&1); then
    print_status "GitHub" "✗" "token expired or invalid" "shimmer github:welcome"
  else
    GH_USER=$(echo "$GH_RESPONSE" | grep '"login"' | head -1 | sed 's/.*"login":"\([^"]*\)".*/\1/')
    GH_EXPIRY=$(echo "$GH_RESPONSE" | grep -i 'github-authentication-token-expiration:' | sed 's/.*: //' | tr -d '\r')
    GH_CHECK="✓" GH_HINT="shimmer github:welcome"

    if [ -n "$GH_EXPIRY" ]; then
      DAYS_LEFT=$("$TASK_DIR/_days-until" "$GH_EXPIRY" 2>/dev/null || echo "")
      if [ -n "$DAYS_LEFT" ] && [ "$DAYS_LEFT" -lt 0 ]; then
        GH_CHECK="✗" GH_HINT="shimmer github:token:regenerate $AGENT"
        GH_USER="$GH_USER (token expired)"
      elif [ -n "$DAYS_LEFT" ] && [ "$DAYS_LEFT" -le 7 ]; then
        GH_CHECK="⚠" GH_HINT="shimmer github:token:regenerate $AGENT"
        GH_USER="$GH_USER (expires in ${DAYS_LEFT}d)"
      elif [ -n "$DAYS_LEFT" ]; then
        GH_USER="$GH_USER (expires in ${DAYS_LEFT}d)"
      fi
    fi

    print_status "GitHub" "$GH_CHECK" "$GH_USER" "$GH_HINT"
  fi

  # Note: Zettel and Blob rows removed from welcome (April 2026).
  # See KnickKnackLabs/shimmer#726 for the full rationale and follow-ups.
  # - Zettel check was incorrect for the modern home-repo layout
  #   (only looked at $HOME/agents/$AGENT/home top-level, missing
  #   notes organised under Zettels/, Inbox/, etc.). Zettel status
  #   should live in each agent's own home-repo welcome task where
  #   the layout is known.
  # - Blob check reported a feature still in flight. Planned to move
  #   to KnickKnackLabs/blobs; until that ships, the check just adds
  #   noise at orientation.
  # The shimmer blob:* tasks themselves remain for agents already
  # using Backblaze via `mc`.
else
  print_status "Email" "?" "set identity first"
  print_status "Matrix" "?" "set identity first"
  print_status "GitHub" "?" "set identity first"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "  shimmer tasks               See all available commands"
echo "  shimmer tasks <group>       Explore a specific group"
echo ""
