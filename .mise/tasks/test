#!/usr/bin/env bash
#MISE description="Run the BATS test suite"
#MISE dir="{{config_root}}"
#USAGE arg "[args]" default="" var=#true help="Test suites, files, or bats arguments"
#USAGE example "mise run test" header="Run all tests in parallel across files"
#USAGE example "mise run test gpg" header="Run a specific suite directory"
#USAGE example "mise run test test/gpg/gpg.bats" header="Run a specific test file"
#USAGE example "mise run test gpg --filter strip_wrapping" header="Filter within a suite"
#USAGE example "mise run test --jobs 1" header="Run serially for debugging"
set -euo pipefail

arguments=()
if [ -n "${usage_args:-}" ]; then
  while IFS= read -r argument; do
    [ -z "$argument" ] || arguments+=("$argument")
  done < <(printf '%s' "$usage_args" | xargs printf '%s\n')
fi

exec "$MISE_CONFIG_ROOT/libexec/test" ${arguments[@]+"${arguments[@]}"}
