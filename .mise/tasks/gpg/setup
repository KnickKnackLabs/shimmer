#!/usr/bin/env bash
#MISE description="Import an agent's GPG key into the current user's keyring"
#USAGE arg "<agent>" help="Agent handle (e.g., quick, x1f9)"
#USAGE example "mise run gpg:setup zeke" header="Prepare an agent signing key"
set -euo pipefail
set +x
set +v

source "$MISE_CONFIG_ROOT/lib/gpg.sh"

AGENT="${usage_agent:?Usage: mise run gpg:setup <agent>}"
# CI may supply the exact fingerprint and private key directly. Local setup
# uses the same SOPS persona signer as activation, never an email-derived key.
FINGERPRINT="${GPG_FINGERPRINT:-}"
if [ -z "$FINGERPRINT" ]; then
  FINGERPRINT=$(secrets get --provider sops "$AGENT/git/signing-fingerprint")
fi
if [[ ! "$FINGERPRINT" =~ ^([A-Fa-f0-9]{40}|[A-Fa-f0-9]{64})$ ]]; then
  echo 'ERROR: a full persona signing fingerprint is required.' >&2
  exit 1
fi
FINGERPRINT=$(printf '%s' "$FINGERPRINT" | tr '[:lower:]' '[:upper:]')

if ! command -v gpg >/dev/null 2>&1; then
  echo 'ERROR: gpg command not found. Please install GnuPG.' >&2
  exit 1
fi

AVAILABLE=$(gpg_secret_signing_fingerprints) || {
  echo 'ERROR: could not inspect secret signing keys.' >&2
  exit 1
}
if grep -Fx "$FINGERPRINT" <<< "$AVAILABLE" >/dev/null; then
  echo "GPG signing key $FINGERPRINT already imported"
else
  PRIVATE_KEY="${GPG_PRIVATE_KEY:-}"
  if [ -z "$PRIVATE_KEY" ]; then
    PRIVATE_KEY=$(secrets get --provider sops "$AGENT/gpg-private-key")
  fi
  PRIVATE_KEY=$(strip_wrapping_quotes "$PRIVATE_KEY")
  validate_gpg_key "$PRIVATE_KEY"

  TMPKEY=$(mktemp)
  trap 'rm -f "$TMPKEY"' EXIT
  printf '%s' "$PRIVATE_KEY" > "$TMPKEY"
  KEY_METADATA=$(gpg --batch --with-colons --import-options show-only --import "$TMPKEY" 2>/dev/null)
  TRUST_FINGERPRINT=$(awk -F: -v signer="$FINGERPRINT" '
    $1 == "pub" || $1 == "sec" {primary = ""}
    $1 == "fpr" {
      if (primary == "") primary = toupper($10)
      if (toupper($10) == signer) print primary
    }
  ' <<< "$KEY_METADATA")
  if [ -z "$TRUST_FINGERPRINT" ]; then
    echo 'ERROR: private key does not match the persona signing fingerprint.' >&2
    exit 1
  fi

  echo "Importing GPG key for $AGENT..."
  gpg --batch --import "$TMPKEY"
  AVAILABLE=$(gpg_secret_signing_fingerprints)
  if ! grep -Fx "$FINGERPRINT" <<< "$AVAILABLE" >/dev/null; then
    echo 'ERROR: imported key has no usable secret key for the persona signer.' >&2
    exit 1
  fi
  if ! printf '%s:6:\n' "$TRUST_FINGERPRINT" | gpg --batch --import-ownertrust; then
    echo "[warn] could not set ultimate trust for $FINGERPRINT" >&2
    exit 1
  fi
fi

echo "GPG key ready for $AGENT"
echo "  Fingerprint: $FINGERPRINT"
echo 'Git configuration unchanged. Activate the persona to select its signer:'
echo "  eval \"\$(shimmer as $AGENT)\""
echo 'Then check: shimmer gpg:status'
