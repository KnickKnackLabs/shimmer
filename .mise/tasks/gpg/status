#!/usr/bin/env bash
#MISE description="Check the current process's effective Git signer and secret key"
#USAGE arg "[agent]" help="Legacy argument; status always checks the current process"
#USAGE example "mise run gpg:status" header="Check active signing"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/gpg.sh"

caller="${SHIMMER_CALLER_PWD:-$PWD}"
name="${GIT_AUTHOR_NAME:-$(git -C "$caller" config user.name || printf '<not set>')}"
email="${GIT_AUTHOR_EMAIL:-$(git -C "$caller" config user.email || printf '<not set>')}"
printf 'Git signing status for %s <%s>\n' "$name" "$email"

if message=$(git_signing_status); then
  printf 'GPG: ✓ %s\n' "$message"
else
  printf 'GPG: ✗ %s\n' "$message"
  echo 'Import the selected key with shimmer gpg:setup <agent>, then activate with shimmer as <agent>.'
  exit 1
fi
