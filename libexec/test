#!/usr/bin/env bash

# Canonical BATS workflow. The public mise task only translates Usage arguments.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_directory="$repo_root/test"
default_parallel_jobs=4
bats_command="${BATS_COMMAND:-bats}"
default_parallel_command="${RUSH_COMMAND:-rush}"

resolved_arguments=()
has_test_target=false
has_within_file_override=false
cli_jobs=""
cli_parallel_command=""

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 2
}

command_available() {
  case "$1" in
    */*) [ -x "$1" ] ;;
    *) command -v "$1" >/dev/null 2>&1 ;;
  esac
}

option_value_kind() {
  case "$1" in
    -j|--jobs) printf 'jobs\n' ;;
    --parallel-binary-name) printf 'parallel-command\n' ;;
    --code-quote-style|--line-reference-format|-f|--filter|--negative-filter|\
      --filter-status|--filter-tags|-F|--formatter|\
      --gather-test-outputs-in|--report-formatter|-o|--output)
      printf 'bats-option\n'
      ;;
    *) return 1 ;;
  esac
}

append_test_target() {
  local argument="$1"

  if [[ "$argument" != *.bats && -d "$test_directory/$argument" ]]; then
    resolved_arguments+=("$test_directory/$argument")
    has_test_target=true
  elif [[ "$argument" != *.bats && -f "$test_directory/$argument.bats" ]]; then
    resolved_arguments+=("$test_directory/$argument.bats")
    has_test_target=true
  else
    resolved_arguments+=("$argument")
    if [[ "$argument" == *.bats || -d "$argument" ]]; then
      has_test_target=true
    fi
  fi
}

resolve_arguments() {
  local argument value_kind pending_value_kind=""

  for argument in ${@+"$@"}; do
    if [ -n "$pending_value_kind" ]; then
      resolved_arguments+=("$argument")
      case "$pending_value_kind" in
        jobs) cli_jobs="$argument" ;;
        parallel-command) cli_parallel_command="$argument" ;;
      esac
      pending_value_kind=""
      continue
    fi

    if value_kind="$(option_value_kind "$argument")"; then
      resolved_arguments+=("$argument")
      pending_value_kind="$value_kind"
      continue
    fi

    case "$argument" in
      --no-parallelize-within-files)
        has_within_file_override=true
        resolved_arguments+=("$argument")
        ;;
      -*) resolved_arguments+=("$argument") ;;
      *) append_test_target "$argument" ;;
    esac
  done

  case "$pending_value_kind" in
    jobs) fail "--jobs requires a positive integer" ;;
    parallel-command) fail "--parallel-binary-name requires a command" ;;
  esac

  if ! $has_test_target; then
    resolved_arguments+=("--recursive" "$test_directory/")
  fi
}

select_parallelism() {
  if [ -n "$cli_jobs" ]; then
    effective_jobs="$cli_jobs"
  elif [ -n "${BATS_NUMBER_OF_PARALLEL_JOBS:-}" ]; then
    effective_jobs="$BATS_NUMBER_OF_PARALLEL_JOBS"
  else
    effective_jobs="$default_parallel_jobs"
    export BATS_NUMBER_OF_PARALLEL_JOBS="$effective_jobs"
  fi

  [[ "$effective_jobs" =~ ^[1-9][0-9]*$ ]] || \
    fail "BATS parallel jobs must be a positive integer, got '$effective_jobs'."

  if [ -n "$cli_parallel_command" ]; then
    effective_parallel_command="$cli_parallel_command"
  elif [ -n "${BATS_PARALLEL_BINARY_NAME:-}" ]; then
    effective_parallel_command="$BATS_PARALLEL_BINARY_NAME"
  else
    effective_parallel_command="$default_parallel_command"
    export BATS_PARALLEL_BINARY_NAME="$effective_parallel_command"
  fi
}

require_commands() {
  if ! command_available "$bats_command"; then
    printf "Error: BATS executable '%s' is unavailable; run 'mise install'.\n" \
      "$bats_command" >&2
    exit 127
  fi

  if [ "$effective_jobs" -gt 1 ] && \
      ! command_available "$effective_parallel_command"; then
    printf "Error: BATS parallel runner '%s' is unavailable for %s jobs; run 'mise install' or use --jobs 1.\n" \
      "$effective_parallel_command" "$effective_jobs" >&2
    exit 127
  fi
}

run_bats() {
  local bats_arguments=(--print-output-on-failure)

  if [ "$effective_jobs" -gt 1 ]; then
    if ! $has_within_file_override; then
      # BATS 1.13 polls its within-file semaphore once per second. Keep each
      # file serial and let Rush schedule independent files without that delay.
      bats_arguments+=(--no-parallelize-within-files)
    fi
    printf 'BATS parallelism: %s jobs across files via %s\n' \
      "$effective_jobs" "$effective_parallel_command"
  else
    printf 'BATS parallelism: serial\n'
  fi

  bats_arguments+=("${resolved_arguments[@]}")
  exec "$bats_command" "${bats_arguments[@]}"
}

main() {
  resolve_arguments "$@"
  select_parallelism
  require_commands
  run_bats
}

main "$@"
